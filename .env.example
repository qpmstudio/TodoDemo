# ============================================================
# TodoDemo — Environment Variables
# Copy: cp .env.example .env
# ============================================================

# --- Server ---
PORT=8080

# --- Database ---
# PostgreSQL: postgres://USER:***@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://tododemo:***@localhost:5432/tododemo?sslmode=disable

# --- OAuth / Third-party ---
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=***

# --- Secrets ---
JWT_SECRET=***

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Callback / Redirect ---
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
