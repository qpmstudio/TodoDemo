# ============================================================
# TodoDemo — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Server ---
# HTTP listen port (default: 8080)
PORT=8080

# --- Database (PostgreSQL) ---
# Connection string for pgxpool:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# Docker Compose:
#   postgres://tododemo:tododemo@db:5432/tododemo?sslmode=disable
# Local dev:
#   postgres://tododemo:tododemo@localhost:5432/tododemo?sslmode=disable
DATABASE_URL=postgres://tododemo:tododemo@localhost:5432/tododemo?sslmode=disable

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/developers
# Homepage URL:     http://localhost:8080
# Callback URL:     http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- JWT ---
# Secret key for signing JWT tokens (change in production!)
JWT_SECRET=dev-secret-change-in-production

# --- Frontend ---
# CORS allowed origin (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# --- GitHub OAuth Redirect ---
# Must match the callback URL registered in GitHub OAuth App
# (default: http://localhost:8080/auth/github/callback)
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
