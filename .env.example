# ============================================================
# TodoDemo — Environment Variables
# Copy: cp .env.example .env
# ============================================================

# --- Server ---
PORT=8080

# --- Logging ---
# 日志级别：debug | info | warn | error（默认 debug，大小写不敏感）
# debug  输出请求/响应 body、查询字符串和数据库查询耗时（敏感字段已脱敏）
# info   只输出请求摘要和错误日志，适合生产环境
LOG_LEVEL=debug

# --- Database ---
# PostgreSQL: postgres://USER:***@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://tododemo:***@localhost:5432/tododemo?sslmode=disable

# --- OAuth / Third-party ---
# GitHub OAuth App 创建入口：https://github.com/settings/developers → New OAuth App
#
#   Application name       任意，例如 TodoDemo (dev)
#   Homepage URL           必须与 FRONTEND_URL 完全一致
#                          本地: http://localhost:5173
#                          线上: https://todo.qpmstudio.dpdns.org
#   Authorization callback URL
#                          必须与 GITHUB_REDIRECT_URL 完全一致
#                          本地: http://localhost:8080/auth/github/callback
#                          线上: https://todo.qpmstudio.dpdns.org/auth/github/callback
#
# 两个 URL 必须精确匹配（协议、域名、端口、路径都要一致，末尾不要带斜杠），
# 否则 GitHub 会返回 redirect_uri_mismatch。
#
# 未配置 GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET 时：
#   - GET /auth/github/login 返回 503（code=SERVICE_UNAVAILABLE），不会把浏览器
#     重定向到 GitHub；
#   - 启动日志会打一条 warn，提示 OAuth app 未配置。
# 线上环境还需要把这两个变量连同公网 URL 写入部署 Secret（tododemo-env）并重启。
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=***

# --- Secrets ---
JWT_SECRET=***

# --- CORS / Frontend ---
# 前端地址，GitHub 登录成功后跳转到 $FRONTEND_URL/todos。
# 本地默认 http://localhost:5173；线上必须是公网地址，否则启动时告警。
FRONTEND_URL=http://localhost:5173

# --- Callback / Redirect ---
# 必须与 OAuth App 的 Authorization callback URL 完全一致。
# 本地默认 http://localhost:8080/auth/github/callback；线上必须是公网地址，
# 否则启动时告警。
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback
