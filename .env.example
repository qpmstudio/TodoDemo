# Copy this to .env and fill in your values
# cp .env.example .env

# GitHub OAuth App credentials (required)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# JWT signing secret (dev default below, change in production)
JWT_SECRET=dev-secret-change-in-production

# Database (for non-Docker dev, set DATABASE_URL instead)
# DATABASE_URL=postgres://tododemo:tododemo@localhost:5432/tododemo?sslmode=disable
