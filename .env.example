# ============================================================
# TodoDemo — Environment Variables
# Copy: cp .env.example .env
# ============================================================

# --- Server ---
PORT=8080

# --- Logging ---
# 日志级别：debug | info | warn | error（默认 debug，大小写不敏感）
# debug  输出请求/响应 body、查询字符串和数据库查询耗时（敏感字段已脱敏）
# info   只输出请求摘要和错误日志，适合生产环境
LOG_LEVEL=debug

# --- Database ---
# PostgreSQL: postgres://USER:***@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://tododemo:***@localhost:5432/tododemo?sslmode=disable

# --- Secrets ---
JWT_SECRET=***

# --- CORS / Frontend ---
# 前端地址，ZITADEL 登录成功后跳转到 $FRONTEND_URL/todos。
# 本地默认 http://localhost:5173；线上必须是公网地址，否则启动时告警。
FRONTEND_URL=http://localhost:5173

# --- ZITADEL (OIDC) ---
# Console: https://auth.qpmstudio.dpdns.org/ui/console
# 在 Project 下建 Web 应用，并精确注册：
#   Redirect URI   http://localhost:8080/auth/zitadel/callback
#                  https://todo.qpmstudio.dpdns.org/auth/zitadel/callback
#   Post Logout    http://localhost:5173/login
#                  https://todo.qpmstudio.dpdns.org/login
# ZITADEL 是 TodoDemo 唯一的登录入口：GitHub OAuth 与邮箱密码登录已下线
# （POST /auth/login 返回 410 LOGIN_MOVED，POST /auth/register 返回 410
# REGISTRATION_MOVED）。未配置 ZITADEL_CLIENT_ID 时登录页不显示登录按钮，
# GET /auth/zitadel/login 返回 503（ZITADEL_NOT_CONFIGURED）。
# 使用 PKCE 的公共客户端可不填 CLIENT_SECRET；机密客户端才需要。
ZITADEL_ISSUER=https://auth.qpmstudio.dpdns.org
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_REDIRECT_URL=http://localhost:8080/auth/zitadel/callback
# 可选；留空时默认 {FRONTEND_URL}/login
ZITADEL_POST_LOGOUT_URL=
# 可选；新用户注册/验证邮箱地址。留空时默认 {ZITADEL_ISSUER}/ui/v2/login/register。
# TodoDemo 已下线自建注册：POST /auth/register 固定返回 410 REGISTRATION_MOVED。
ZITADEL_REGISTER_URL=
# 可选；未验证邮箱的用户点击「去验证」时打开的 ZITADEL 入口。留空时默认
# {ZITADEL_ISSUER}/ui/v2/login。登录被 403 EMAIL_NOT_VERIFIED 拒绝时，
# 响应会带 verify_url，并尝试用用户自己的 access token 重发验证邮件。
ZITADEL_VERIFY_URL=
